{
  "name": "kotoba",
  "version": "3.1.0-preview.18",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-japanese-tools.mjs && node scripts/check-public-environment.mjs development && next dev --hostname 0.0.0.0",
    "build": "node scripts/prepare-japanese-tools.mjs && node --import tsx scripts/vocabulary-audit.mjs && node --import tsx scripts/build-content.mjs && node scripts/check-public-environment.mjs && next build && node scripts/finalize-pwa.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "backend:configure": "node --env-file=.env.local scripts/configure-private-account.mjs",
    "qa:responsive": "node scripts/responsive-audit.mjs",
    "backend:check": "node scripts/check-supabase-connection.mjs",
    "lint": "eslint app components lib scripts tests public/api --max-warnings=0",
    "content:audit": "node --import tsx scripts/content-audit.mjs",
    "content:build": "node --import tsx scripts/build-content.mjs",
    "test:content:backend": "node --import tsx scripts/test-content-backend.mjs",
    "test:beta:backend": "node --import tsx scripts/test-limited-beta-backend.mjs",
    "test:beta:auth": "node --import tsx scripts/test-limited-beta-auth.mjs",
    "qa:beta:mobile": "node --import tsx scripts/beta-mobile-audit.mjs",
    "vocabulary:audit": "node --import tsx scripts/vocabulary-audit.mjs",
    "release:verify": "node scripts/verify-site-release.mjs",
    "test:updates:browser": "node scripts/update-recovery-audit.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/supabase-js": "^2.57.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "kuromoji": "0.1.2",
    "kuroshiro": "1.2.1",
    "kuroshiro-analyzer-kuromoji": "1.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "path-browserify": "1.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "wanakana": "5.3.1",
    "wink-eng-lite-web-model": "1.8.1",
    "wink-nlp": "2.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "type": "module"
}

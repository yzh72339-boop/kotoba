# Your own Supabase project; no production credentials are included.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted local bootstrap / server-side only. Never NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_USER_EMAIL=
PRIVATE_ACCOUNT_PASSWORD=
SITE_ORIGIN=http://localhost:3000

# Optional OAuth: configure the real Google secret directly in Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional AI: configure server / Edge Function secrets only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
